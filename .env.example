# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NEVER commit .env to git.

# Required for CrewAI scenarios:
OPENAI_API_KEY=sk-your-openai-key-here

# Required for passenger profiles (Snowflake MCP):
SNOWFLAKE_PAT=your-snowflake-programmatic-access-token
SNOWFLAKE_ACCOUNT_URL=https://<your-account>.snowflakecomputing.com

# Required for Iceberg on Cloudera AI (your object-store path):
ICEBERG_WAREHOUSE_URI=abfs://<container>@<account>.dfs.core.windows.net/<path>

# Optional — Iceberg runtime jar (defaults to newest jar under /opt/spark/optional-lib/):
# ICEBERG_JAR=/opt/spark/optional-lib/iceberg-spark-runtime.jar

# Set automatically by Cloudera AI when running as an Application:
# CDSW_APP_PORT=8090
